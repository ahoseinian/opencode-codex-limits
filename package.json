{
  "name": "opencode-codex-limits",
  "version": "0.1.5",
  "description": "OpenCode plugin that shows ChatGPT/Codex usage quota in the sidebar",
  "license": "MIT",
  "type": "module",
  "main": "./dist/tui.js",
  "exports": {
    ".": {
      "import": "./dist/tui.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahoseinian/opencode-codex-limits.git"
  },
  "scripts": {
    "build": "bun build ./tui.tsx --outdir ./dist --target bun --external @opencode-ai/plugin --external @opentui/solid --external solid-js",
    "prepublishOnly": "bun run typecheck && bun run test && bun run lint && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint tui.tsx src/",
    "lint:fix": "oxlint --fix tui.tsx src/",
    "format": "oxfmt package.json tsconfig.json .oxlintrc.json .oxfmtrc.json tui.tsx TODO.md \"src/**/*.ts\"",
    "format:check": "oxfmt --check package.json tsconfig.json .oxlintrc.json .oxfmtrc.json tui.tsx TODO.md \"src/**/*.ts\""
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.2.27",
    "@opentui/solid": "^0.1.101",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest"
  }
}
