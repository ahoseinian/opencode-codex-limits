{
  "name": "opencode-codex-limits",
  "version": "0.2.0-beta.2",
  "description": "OpenCode plugin that shows ChatGPT/Codex usage quota in the sidebar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahoseinian/opencode-codex-limits.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "import": "./dist/src/rpc.js"
    }
  },
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run lint && bun run format:check && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-19086"
  },
  "devDependencies": {
    "@opencode-ai/theme": "0.0.0-beta-19086",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/bun": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "solid-js": "1.9.12",
    "typescript": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  }
}
