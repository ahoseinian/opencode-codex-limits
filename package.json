{
  "name": "opencode-codex-limits",
  "version": "0.1.6",
  "description": "OpenCode plugin that shows ChatGPT/Codex usage quota in the sidebar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahoseinian/opencode-codex-limits.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/tui.js",
  "exports": {
    ".": {
      "import": "./dist/tui.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run lint && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.2.27",
    "@opentui/solid": "^0.1.101",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest"
  }
}
